{
  "name": "KisanMitra-frontend",
  "version": 2,
  "buildCommand": "CI=false DISABLE_ESLINT_PLUGIN=true npm run build",
  "env": {
    "CI": "false",
    "GENERATE_SOURCEMAP": "false",
    "DISABLE_ESLINT_PLUGIN": "true"
  },
  "outputDirectory": "build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
